# Secrets / local config (any .env variant: .env.local, .env.bak...)
.env
.env.*
!.env.example
.claude/settings.local.json

# Internal content: never commit (public repo)
# - synced Confluence pages
raw-data/

# - LanceDB index (contains page text)
data/

# - internal planning notes and results
_docs/

# - golden set and LLM bench questions derived from internal docs, any variant
#   (eval/queries.yaml, eval/bench.yaml, eval/bench2.yaml...); only the examples are public
eval/*.yaml
!eval/*.example.yaml

# Python / tooling
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
