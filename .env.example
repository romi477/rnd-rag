# Confluence Cloud access for scripts/confluence_sync.py
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE_URL=https://ventortech.atlassian.net
CONFLUENCE_EMAIL=you@example.com
# Falls back to $JIRA_TOKEN_VENT from shell env when empty
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=pd

# Answer generation (stage 2): any OpenAI-compatible server, LM Studio by default
# RAG_LLM_BASE_URL=http://127.0.0.1:1234/v1
# RAG_LLM_MODEL=            # empty: the model currently loaded in LM Studio
# RAG_LLM_REASONING=none    # sent as reasoning_effort; empty to leave thinking on
