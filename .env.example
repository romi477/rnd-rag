# Confluence Cloud access for `rag sync` (scripts/sync.sh)
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE_URL=https://ventortech.atlassian.net
CONFLUENCE_EMAIL=you@example.com
# Falls back to $JIRA_TOKEN_VENT from shell env when empty
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=pd

# Answer generation: "openai" = any OpenAI-compatible server (LM Studio by default, local),
# "anthropic" = the Claude API (each answer sends the question and doc excerpts to Anthropic)
# RAG_LLM_PROVIDER=openai
# RAG_LLM_BASE_URL=http://127.0.0.1:1234/v1
# ANTHROPIC_API_KEY=        # with RAG_LLM_PROVIDER=anthropic
# RAG_LLM_MODEL=            # empty: the model loaded in LM Studio, or claude-sonnet-5-5 (LM Studio answers an id that is not loaded with the loaded model)
# RAG_CLAUDE_MODELS=claude-sonnet-5-5,claude-haiku-5-5   # Claude models offered in the UI
# RAG_ANSWERS_PER_HOUR=200  # /api/answer requests per hour (Claude answers are billed); 0: no limit
# RAG_LLM_REASONING=none    # as little thinking as the model allows; Claude also takes low/medium/high; empty: default
# RAG_LLM_MAX_TOKENS=1000      # answer length limit for documentation answers (x1.3 es, x1.4 de, x1.7 pl, x2 ru)
# RAG_CODE_LLM_MAX_TOKENS=2000 # the same for code answers (traceback explanations)
# RAG_ANSWER_LANGUAGE=en     # language of LLM answers when a request names none: en, es, de, pl, ru
# RAG_LLM_TEMPERATURE=0.2
# RAG_LLM_CONTEXT_PAGES=5       # pages quoted in a documentation answer
# RAG_LLM_CONTEXT_TOKENS=4000   # token budget of those pages

# Code corpus (experimental): Odoo addons and traceback analysis (scripts/module.sh, scripts/trace.sh)
# Source code is not documentation: set 1 only if sending it to the Claude API (RAG_LLM_PROVIDER=anthropic) is allowed
# RAG_CODE_EXTERNAL_LLM=0
# RAG_CODE_CONTEXT_TOKENS=5000  # evidence packed into the prompt of a code answer
# RAG_CODE_INNER_FRAMES=3       # innermost traceback frames quoted in full (the others as signature + call site)
# RAG_CODE_MAX_TOKENS=500       # code units longer than this (approx. tokens) are split before embedding; re-add modules after a change
# RAG_TRACES_FILE=eval/traces.yaml

# Retrieval and indexing (changing the models, RAG_CHUNK_* or RAG_CODE_MAX_TOKENS means re-indexing)
# RAG_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_HYBRID_FTS_WEIGHT=0.3     # BM25 weight in the hybrid fusion
# RAG_RERANK_CANDIDATES=10
# RAG_RERANK_MIN_SCORE=0.1      # pages below it are flagged low relevance and not sent to the LLM
# RAG_CHUNK_MAX_TOKENS=500
# RAG_CHUNK_MIN_TOKENS=80

# Paths (defaults are inside the project)
# RAG_RAW_DIR=raw-data/confluence
# RAG_DATA_DIR=data
# RAG_EVAL_FILE=eval/queries.yaml
# RAG_BENCH_FILE=eval/bench.yaml

# Web UI (scripts/serve.sh): host names the server answers to. Binding beyond localhost
# (RAG_HOST=0.0.0.0) exposes the internal docs; add the machine's name here only if you mean it.
# RAG_ALLOWED_HOSTS=127.0.0.1,localhost

# Access token for the UI and the API (HTTP Basic: the token is the password, any user name). Empty: no login.
# Set it before RAG_HOST=0.0.0.0; use HTTPS beyond a trusted network. Generate: openssl rand -hex 24
# RAG_API_TOKEN=
